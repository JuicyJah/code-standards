{
  "name": "standards-builder",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Browse, select, customize, and export code & API standards as a markdown pack.",
  "scripts": {
    "gen": "node ../scripts/build-catalog.mjs",
    "predev": "npm run gen",
    "dev": "vite",
    "prebuild": "npm run gen",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "check": "svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "jsdom": "^25.0.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "marked": "^15.0.6"
  }
}
